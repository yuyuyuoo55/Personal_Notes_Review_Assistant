# 用户 DeepSeek Key 不写在这里，由用户在 Streamlit 页面中自行输入。
# 后端部署者只配置 Embedding、OSS 和可选 Qwen-VL 后备所需的密钥。
DASHSCOPE_API_KEY=YOUR_API_KEY_HERE

DEEPSEEK_TEXT_MODEL=deepseek-v4-flash
DEEPSEEK_VISION_MODEL=deepseek-v4-flash-vision-exp
DEEPSEEK_API_BASE_URL=https://api.deepseek.com

# 阿里云 OSS：Markdown 内图片会先上传 OSS，再交给 VLM 获取描述。
OSS_ACCESS_KEY_ID=YOUR_OSS_ACCESS_KEY_ID_HERE
OSS_ACCESS_KEY_SECRET=YOUR_OSS_ACCESS_KEY_SECRET_HERE
OSS_ENDPOINT=https://oss-cn-YOUR_REGION.aliyuncs.com
OSS_BUCKET_NAME=YOUR_BUCKET_NAME
OSS_PUBLIC_BASE_URL=https://YOUR_BUCKET_NAME.oss-cn-YOUR_REGION.aliyuncs.com
OSS_OBJECT_PREFIX=personal-notes/images
# OSS_PUBLIC_BASE_URL 留空时使用短时签名 URL，更适合私有 Bucket。
OSS_URL_EXPIRES_SECONDS=3600

# DeepSeek 图片识别失败后是否使用部署者的 DashScope Key 调用 Qwen-VL。
# 默认关闭，开启后费用由部署者承担。
VLM_FALLBACK_TO_QWEN=false
QWEN_VL_MODEL=qwen-vl-max
VLM_TIMEOUT_SECONDS=60
MAX_IMAGE_BYTES=8388608

# Streamlit 调用本地 FastAPI 的地址
API_BASE_URL=http://127.0.0.1:8000

# Chroma 数据目录；相对路径基于项目根目录解析。
CHROMA_PERSIST_DIRECTORY=data/chroma
CHROMA_COLLECTION_NAME=notes
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v4

# BM25 本地索引目录；导入新笔记并重建索引时会更新它。
BM25_INDEX_PATH=data/bm25/notes.bm25
